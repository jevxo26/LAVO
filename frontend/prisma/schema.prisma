  updatedAt  DateTime        @updatedAt
  careLabels CareLabel[]
  category   GarmentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  services   Service[]
}

model Service {
  id                String                        @id @default(uuid())
  serviceCategoryId String
  garmentTypeId     String
  serviceName       String
  description       String?
  basePrice         Float                         @default(0.0)
  estimatedTime     String?
  status            String                        @default("ACTIVE")
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt
  branchPricings    BranchPricing[]
  orderItems        OrderItem[]
  priceHistories    PriceHistory[]
  garmentType       GarmentType                   @relation(fields: [garmentTypeId], references: [id], onDelete: Cascade)
  addons            ServiceAddon[]
  analytics         ServiceAnalytics[]
  availabilities    ServiceAvailability[]
  discounts         ServiceDiscount[]
  durations         ServiceDuration[]
  instructions      ServiceInstruction[]
  inventoryReqs     ServiceInventoryRequirement[]
  options           ServiceOption[]
  pricings          ServicePricing[]
  taxes             ServiceTax[]
  variants          ServiceVariant[]
  vendorPricings    VendorPricing[]
  zonePricings      ZonePricing[]
}

model ServiceVariant {
  id            String   @id @default(uuid())
  serviceId     String
  variantName   String
  description   String?
  price         Float
  estimatedTime String?
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  service       Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model ServiceOption {
  id         String   @id @default(uuid())
  serviceId  String
  optionName String
  optionType String
  price      Float
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model ServiceAddon {
  id          String   @id @default(uuid())
  serviceId   String
  addonName   String
  price       Float
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model ServicePricing {
  id            String    @id @default(uuid())
  serviceId     String
  garmentTypeId String
  basePrice     Float
  unit          String
  currency      String    @default("BDT")
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  service       Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model ZonePricing {
  id             String   @id @default(uuid())
  zoneId         String
  serviceId      String
  price          Float
  pickupCharge   Float    @default(0.0)
  deliveryCharge Float    @default(0.0)
  expressCharge  Float    @default(0.0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  service        Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model BranchPricing {
  id        String   @id @default(uuid())
  branchId  String
  serviceId String
  price     Float
  discount  Float    @default(0.0)
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model VendorPricing {
  id             String   @id @default(uuid())
  vendorId       String
  serviceId      String
  processingCost Float
  vendorRate     Float
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  service        Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model ServiceDuration {
  id             String   @id @default(uuid())
  serviceId      String
  estimatedHours Float
  estimatedDays  Float
  expressHours   Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  service        Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model ServiceTax {
  id            String   @id @default(uuid())
  serviceId     String
  taxName       String
  taxPercentage Float
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  service       Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model ServiceDiscount {
  id            String   @id @default(uuid())
  serviceId     String
  discountType  String
  discountValue Float
  startDate     DateTime
  endDate       DateTime
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  service       Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model ServiceAvailability {
  id          String   @id @default(uuid())
  serviceId   String
  branchId    String?
  vendorId    String?
  zoneId      String?
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model ServiceInventoryRequirement {
  id            String   @id @default(uuid())
  serviceId     String
  inventoryItem String
  quantity      Float
  unit          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  service       Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model ServiceInstruction {
  id               String   @id @default(uuid())
  serviceId        String
  instructionTitle String
  instruction      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  service          Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model CareLabel {
  id            String      @id @default(uuid())
  garmentTypeId String
  labelName     String
  symbol        String?
  description   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  garmentType   GarmentType @relation(fields: [garmentTypeId], references: [id], onDelete: Cascade)
}

model ServiceAnalytics {
  id                    String   @id @default(uuid())
  serviceId             String
  totalOrders           Int      @default(0)
  totalRevenue          Float    @default(0.0)
  averageCompletionTime Float    @default(0.0)
  averageRating         Float    @default(0.0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  service               Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model PriceHistory {
  id            String   @id @default(uuid())
  serviceId     String
  oldPrice      Float
  newPrice      Float
  changedBy     String?
  effectiveDate DateTime
  reason        String?
  createdAt     DateTime @default(now())
  service       Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model CmsPage {
  id          String       @id @default(uuid())
  slug        String       @unique
  title       String
  description String?
  status      String       @default("PUBLISHED")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  sections    CmsSection[]
}

model CmsSection {
  id           String           @id @default(uuid())
  pageId       String
  sectionKey   String
  title        String?
  subtitle     String?
  content      String?
  image        String?
  displayOrder Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  items        CmsContentItem[]
  page         CmsPage          @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, sectionKey])
}

model CmsContentItem {
  id           String     @id @default(uuid())
  sectionId    String
  title        String?
  subtitle     String?
  content      String?
  icon         String?
  image        String?
  linkUrl      String?
  linkText     String?
  displayOrder Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  section      CmsSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
}

model PartnerApplication {
  id           String                   @id @default(uuid())
  userId       String
  phone        String
  targetCity   String
  experience   String?
  reason       String
  status       PartnerApplicationStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  remarks      String?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  reviewedBy   User?                    @relation("PartnerApplicationReviewer", fields: [reviewedById], references: [id])
  user         User                     @relation("PartnerApplicationOwner", fields: [userId], references: [id], onDelete: Cascade)
}

enum PartnerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}
