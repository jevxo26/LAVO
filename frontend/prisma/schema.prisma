generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                          String                   @id @default(uuid())
  fullName                    String
  email                       String                   @unique
  phone                       String?                  @unique
  password                    String?
  userType                    String
  status                      String                   @default("ACTIVE")
  isVerified                  Boolean                  @default(false)
  profileImage                String?
  lastLogin                   DateTime?
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt
  deletedAt                   DateTime?
  fcmTokens                   String[]                 @default([])
  adminPermission             AdminPermission?
  customer                    Customer?
  customerPreference          CustomerPreference?
  deliveryAgent               DeliveryAgent?
  reviewedPartnerApplications PartnerApplication[]     @relation("PartnerApplicationReviewer")
  partnerApplications         PartnerApplication[]     @relation("PartnerApplicationOwner")
  pickupAgent                 PickupAgent?
  addresses                   UserAddress[]
  devices                     UserDevice[]
  loginHistory                UserLoginHistory[]
  notificationSettings        UserNotificationSetting?
  otps                        UserOTP[]
  profile                     UserProfile?
  roles                       UserRole[]
  security                    UserSecurity?
  sessions                    UserSession[]
  tokens                      UserToken[]
}

model UserProfile {
  id                String    @id @default(uuid())
  userId            String    @unique
  gender            String?
  dateOfBirth       DateTime?
  nationality       String?
  occupation        String?
  preferredLanguage String?
  profilePhoto      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserAddress {
  id            String   @id @default(uuid())
  userId        String
  label         String?
  receiverName  String
  receiverPhone String
  country       String
  division      String?
  district      String?
  city          String
  area          String?
  zone          String?
  postalCode    String?
  fullAddress   String
  latitude      Float?
  longitude     Float?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserDevice {
  id              String    @id @default(uuid())
  userId          String
  deviceId        String
  deviceName      String?
  platform        String?
  operatingSystem String?
  browser         String?
  appVersion      String?
  pushToken       String?
  lastActive      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSession {
  id           String    @id @default(uuid())
  userId       String
  accessToken  String    @unique
  refreshToken String?   @unique
  loginTime    DateTime  @default(now())
  logoutTime   DateTime?
  ipAddress    String?
  deviceId     String?
  status       String    @default("ACTIVE")
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  tokenType String
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserOTP {
  id         String    @id @default(uuid())
  userId     String
  phone      String?
  email      String?
  otpCode    String
  purpose    String
  expiresAt  DateTime
  verifiedAt DateTime?
  status     String    @default("PENDING")
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserLoginHistory {
  id          String    @id @default(uuid())
  userId      String
  device      String?
  browser     String?
  platform    String?
  ipAddress   String?
  loginMethod String?
  loginStatus String?
  loginTime   DateTime  @default(now())
  logoutTime  DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserNotificationSetting {
  id                    String   @id @default(uuid())
  userId                String   @unique
  pushNotification      Boolean  @default(true)
  emailNotification     Boolean  @default(true)
  smsNotification       Boolean  @default(true)
  marketingNotification Boolean  @default(true)
  orderNotification     Boolean  @default(true)
  promotionNotification Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSecurity {
  id                  String    @id @default(uuid())
  userId              String    @unique
  twoFactorEnabled    Boolean   @default(false)
  securityQuestion    String?
  securityAnswer      String?
  passwordChangedAt   DateTime?
  failedLoginAttempts Int       @default(0)
  accountLocked       Boolean   @default(false)
  lockUntil           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CustomerPreference {
  id                    String   @id @default(uuid())
  userId                String   @unique
  preferredBranch       String?
  preferredPickupTime   String?
  preferredDeliveryTime String?
  favoriteServices      String?
  favoriteAddress       String?
  language              String?  @default("en")
  currency              String?  @default("BDT")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Role {
  id            String           @id @default(uuid())
  name          String           @unique
  displayName   String
  description   String?
  roleType      String
  status        String           @default("ACTIVE")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  deletedAt     DateTime?
  employeeRoles EmployeeRole[]
  permissions   RolePermission[]
  users         UserRole[]
}

model Permission {
  id                  String               @id @default(uuid())
  module              String
  permissionName      String
  action              String
  description         String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  branchPermissions   BranchPermission[]
  employeePermissions EmployeePermission[]
  roles               RolePermission[]
  vendorPermissions   VendorPermission[]
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserRole {
  id         String   @id @default(uuid())
  userId     String
  roleId     String
  assignedBy String?
  assignedAt DateTime @default(now())
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model BranchRole {
  id          String             @id @default(uuid())
  branchId    String
  roleName    String
  description String?
  status      String             @default("ACTIVE")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  permissions BranchPermission[]
}

model BranchPermission {
  id           String     @id @default(uuid())
  branchRoleId String
  permissionId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  branchRole   BranchRole @relation(fields: [branchRoleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([branchRoleId, permissionId])
}

model VendorRole {
  id          String             @id @default(uuid())
  vendorId    String
  roleName    String
  description String?
  status      String             @default("ACTIVE")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  permissions VendorPermission[]
}

model VendorPermission {
  id           String     @id @default(uuid())
  vendorRoleId String
  permissionId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  vendorRole   VendorRole @relation(fields: [vendorRoleId], references: [id], onDelete: Cascade)

  @@unique([vendorRoleId, permissionId])
}

model EmployeeRole {
  id         String   @id @default(uuid())
  employeeId String
  roleId     String
  branchId   String?
  vendorId   String?
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
}

model EmployeePermission {
  id           String     @id @default(uuid())
  employeeId   String
  permissionId String
  canView      Boolean    @default(false)
  canCreate    Boolean    @default(false)
  canUpdate    Boolean    @default(false)
  canDelete    Boolean    @default(false)
  canApprove   Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
}

model AdminPermission {
  id                   String   @id @default(uuid())
  userId               String   @unique
  canManageCustomerOps Boolean  @default(false)
  canManageBranchOps   Boolean  @default(false)
  canManageVendorOps   Boolean  @default(false)
  canManageAgentOps    Boolean  @default(false)
  canManageEmployeeOps Boolean  @default(false)
  canManageFinance     Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Customer {
  id                     String                  @id @default(uuid())
  userId                 String                  @unique
  customerCode           String                  @unique
  status                 String                  @default("ACTIVE")
  registrationSource     String?
  totalOrders            Int                     @default(0)
  completedOrders        Int                     @default(0)
  cancelledOrders        Int                     @default(0)
  totalSpent             Float                   @default(0.0)
  walletBalance          Float                   @default(0.0)
  loyaltyPoints          Int                     @default(0)
  membershipId           String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  cashbacks              Cashback[]
  couponUsages           CouponUsage[]
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities             CustomerActivity[]
  addresses              CustomerAddress[]
  coupons                CustomerCoupon[]
  loyaltyPointRecord     CustomerLoyaltyPoint?
  memberships            CustomerMembership[]
  notifications          CustomerNotification[]
  customerProfile        CustomerProfile?
  subscriptions          CustomerSubscription[]
  customerSupportTickets CustomerSupportTicket[]
  wallets                CustomerWallet[]
  deliveries             Delivery[]
  favoriteServices       FavoriteService[]
  orders                 Order[]
  payments               Payment[]
  pickupRequests         PickupRequest[]
  referrals              Referral[]
  reviews                Review[]
  savedPickupSchedules   SavedPickupSchedule[]
  supportTickets         SupportTicket[]
}

model CustomerProfile {
  id                String    @id @default(uuid())
  customerId        String    @unique
  fullName          String
  email             String    @unique
  phone             String    @unique
  gender            String?
  dateOfBirth       DateTime?
  profileImage      String?
  preferredLanguage String?
  preferredBranch   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  customer          Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model CustomerAddress {
  id            String   @id @default(uuid())
  customerId    String
  label         String?
  receiverName  String
  receiverPhone String
  division      String?
  district      String?
  city          String
  area          String?
  zone          String?
  postalCode    String?
  fullAddress   String
  latitude      Float?
  longitude     Float?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model CustomerWallet {
  id                String                @id @default(uuid())
  customerId        String
  balance           Float                 @default(0.0)
  currency          String                @default("BDT")
  status            String                @default("ACTIVE")
  lastTransactionAt DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  transactions      CustomerTransaction[]
  customer          Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model CustomerTransaction {
  id              String         @id @default(uuid())
  walletId        String
  transactionType String
  amount          Float
  referenceType   String?
  referenceId     String?
  paymentMethod   String?
  status          String         @default("COMPLETED")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  wallet          CustomerWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([status])
  @@index([referenceId])
  @@index([createdAt])
}

model CustomerLoyaltyPoint {
  id              String   @id @default(uuid())
  customerId      String   @unique
  earnedPoints    Int      @default(0)
  redeemedPoints  Int      @default(0)
  availablePoints Int      @default(0)
  expiredPoints   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Referral {
  id                  String           @id @default(uuid())
  customerId          String
  referralCode        String           @unique
  totalReferrals      Int              @default(0)
  successfulReferrals Int              @default(0)
  status              String           @default("ACTIVE")
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  customer            Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rewards             ReferralReward[]
}

model ReferralReward {
  id           String    @id @default(uuid())
  referralId   String
  rewardType   String
  rewardValue  Float
  rewardStatus String    @default("PENDING")
  rewardDate   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  referral     Referral  @relation(fields: [referralId], references: [id], onDelete: Cascade)
}

model FavoriteService {
  id                String   @id @default(uuid())
  customerId        String
  serviceId         String
  serviceCategoryId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  customer          Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model SavedPickupSchedule {
  id         String   @id @default(uuid())
  customerId String
  title      String
  pickupDay  String
  pickupTime String
  repeatType String
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model CustomerSubscription {
  id           String   @id @default(uuid())
  customerId   String
  planName     String
  billingCycle String
  price        Float
  startDate    DateTime
  endDate      DateTime
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model CustomerMembership {
  id                 String   @id @default(uuid())
  customerId         String
  membershipType     String
  discountPercentage Float
  benefits           String?
  startDate          DateTime
  expiryDate         DateTime
  status             String   @default("ACTIVE")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  customer           Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model CustomerCoupon {
  id            String   @id @default(uuid())
  customerId    String
  couponCode    String
  discountType  String
  discountValue Float
  expiryDate    DateTime
  usageStatus   String   @default("UNUSED")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model CustomerNotification {
  id               String   @id @default(uuid())
  customerId       String
  title            String
  message          String
  notificationType String
  isRead           Boolean  @default(false)
  sentAt           DateTime @default(now())
  createdAt        DateTime @default(now())
  customer         Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model CustomerActivity {
  id           String   @id @default(uuid())
  customerId   String
  activityType String
  description  String?
  ipAddress    String?
  device       String?
  createdAt    DateTime @default(now())
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model CustomerSupportTicket {
  id           String    @id @default(uuid())
  customerId   String
  ticketNumber String    @unique
  subject      String
  category     String
  priority     String    @default("NORMAL")
  status       String    @default("OPEN")
  assignedTo   String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Branch {
  id                 String                   @id @default(uuid())
  branchCode         String                   @unique
  branchName         String
  branchType         String
  email              String?
  phone              String?
  country            String
  division           String?
  district           String?
  city               String
  area               String?
  zone               String?
  postalCode         String?
  address            String
  latitude           Float?
  longitude          Float?
  managerId          String?
  status             String                   @default("ACTIVE")
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  deletedAt          DateTime?
  analytics          BranchAnalytics[]
  capacity           BranchCapacity?
  coverageZones      BranchCoverageZone[]
  deliverySchedules  BranchDeliverySchedule[]
  departments        BranchDepartment[]
  employees          BranchEmployee[]
  expenses           BranchExpense[]
  holidays           BranchHoliday[]
  inventories        BranchInventory[]
  machines           BranchMachine[]
  managers           BranchManager[]
  notifications      BranchNotification[]
  performance        BranchPerformance?
  pickupSchedules    BranchPickupSchedule[]
  revenues           BranchRevenue[]
  services           BranchService[]
  settings           BranchSetting?
  workingHours       BranchWorkingHour[]
  deliveries         Delivery[]
  deliveryAgents     DeliveryAgent[]
  laundryProcessings LaundryProcessing[]
  orders             Order[]
  pickupRequests     PickupRequest[]
  processingBatches  ProcessingBatch[]
  vendors            Vendor[]
}

model BranchEmployee {
  id             String    @id @default(uuid())
  branchId       String
  employeeId     String
  designation    String?
  departmentId   String?
  joiningDate    DateTime?
  salary         Float?
  employmentType String?
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  branch         Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, employeeId])
  @@index([branchId])
  @@index([employeeId])
}

model BranchManager {
  id           String   @id @default(uuid())
  branchId     String
  userId       String
  assignedDate DateTime @default(now())
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  branch       Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

model BranchDepartment {
  id             String   @id @default(uuid())
  branchId       String
  departmentName String
  description    String?
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  branch         Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

model BranchMachine {
  id           String                     @id @default(uuid())
  branchId     String
  machineCode  String                     @unique
  machineName  String
  machineType  String
  brand        String?
  capacity     String?
  purchaseDate DateTime?
  status       String                     @default("ACTIVE")
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  branch       Branch                     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  maintenances BranchMachineMaintenance[]
}

model BranchMachineMaintenance {
  id                  String        @id @default(uuid())
  machineId           String
  maintenanceType     String
  description         String?
  maintenanceDate     DateTime
  nextMaintenanceDate DateTime?
  cost                Float         @default(0.0)
  status              String        @default("COMPLETED")
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  machine             BranchMachine @relation(fields: [machineId], references: [id], onDelete: Cascade)
}

model BranchInventory {
  id           String                       @id @default(uuid())
  branchId     String
  itemName     String
  category     String
  quantity     Float
  unit         String
  minimumStock Float                        @default(0)
  currentStock Float                        @default(0)
  status       String                       @default("ACTIVE")
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt
  branch       Branch                       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  transactions BranchInventoryTransaction[]
}

model BranchInventoryTransaction {
  id              String          @id @default(uuid())
  inventoryId     String
  transactionType String
  quantity        Float
  reference       String?
  performedBy     String?
  createdAt       DateTime        @default(now())
  inventory       BranchInventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
}

model BranchCapacity {
  id                String   @id @default(uuid())
  branchId          String   @unique
  dailyCapacity     Int
  currentOrders     Int      @default(0)
  availableCapacity Int      @default(0)
  maximumCapacity   Int
  updatedAt         DateTime @updatedAt
  branch            Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

model BranchWorkingHour {
  id          String   @id @default(uuid())
  branchId    String
  day         String
  openingTime String
  closingTime String
  isOpen      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

model BranchHoliday {
  id          String   @id @default(uuid())
  branchId    String
  holidayName String
  holidayDate DateTime
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

model BranchService {
  id            String   @id @default(uuid())
  branchId      String
  serviceId     String
  price         Float
  estimatedTime String?
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

model BranchCoverageZone {
  id                String   @id @default(uuid())
  branchId          String
  zoneId            String
  pickupAvailable   Boolean  @default(true)
  deliveryAvailable Boolean  @default(true)
  status            String   @default("ACTIVE")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  branch            Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

model BranchPickupSchedule {
  id            String   @id @default(uuid())
  branchId      String
  pickupAgentId String
  pickupDate    DateTime
  pickupTime    String
  maximumOrders Int      @default(0)
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

model BranchDeliverySchedule {
  id              String   @id @default(uuid())
  branchId        String
  deliveryAgentId String
  deliveryDate    DateTime
  deliveryTime    String
  maximumOrders   Int      @default(0)
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  branch          Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

model BranchExpense {
  id          String   @id @default(uuid())
  branchId    String
  expenseType String
  amount      Float
  description String?
  expenseDate DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

model BranchRevenue {
  id                String   @id @default(uuid())
  branchId          String
  totalRevenue      Float
  completedOrders   Int
  averageOrderValue Float
  revenueDate       DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  branch            Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

model BranchPerformance {
  id                    String   @id @default(uuid())
  branchId              String   @unique
  completedOrders       Int      @default(0)
